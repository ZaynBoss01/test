-- FINAL REPORT
-- ============================================
local function GenerateReport()
    print("\n"..string.rep("=", 50))
    print("🔒 SECURITY TEST REPORT")
    print(string.rep("=", 50))
    
    local passed = 0
    local total = 0
    
    for testName, result in pairs(TestResults) do
        total = total + 1
        if result then
            passed = passed + 1
            print("✅", testName, "- PASSED")
        else
            print("❌", testName, "- FAILED")
        end
    end
    
    print(string.rep("-", 50))
    print("Results:", passed, "/", total, "tests passed")
    print("Vulnerabilities Found:", VulnerabilitiesFound)
    
    if VulnerabilitiesFound == 0 then
        print("\n🎉 EXCELLENT! Your Firebase protection appears secure!")
    elseif VulnerabilitiesFound < 3 then
        print("\n⚠️ MODERATE RISK: Some vulnerabilities detected")
    else
        print("\n🚨 HIGH RISK: Multiple vulnerabilities found!")
    end
    
    print(string.rep("=", 50))
end

