local AdvancedTests = {}

-- Exploit technique: Hooking game.HttpGet
function AdvancedTests.TestHttpGetHook()
    local originalHttpGet = game.HttpGet
    local capturedUrls = {}
    
    -- Attempt to hook (simulating exploit behavior)
    local success = pcall(function()
        game.HttpGet = function(self, url, ...)
            table.insert(capturedUrls, url)
            return originalHttpGet(self, url, ...)
        end
    end)
    
    return {
        test = "HttpGet Hooking",
        vulnerable = success,
        captured = capturedUrls
    }
end

-- Exploit technique: RequestAsync interception
function AdvancedTests.TestRequestAsyncHook()
    local HttpService = game:GetService("HttpService")
    local requests = {}
    
    local success = pcall(function()
        local oldRequest = HttpService.RequestAsync
        HttpService.RequestAsync = function(self, request)
            if request and request.Url then
                table.insert(requests, request.Url)
            end
            return oldRequest(self, request)
        end
    end)
    
    return {
        test = "RequestAsync Interception",
        vulnerable = success,
        requests = requests
    }
end

-- Exploit technique: String reconstruction
function AdvancedTests.TestStringReconstruction()
    local reconstructed = {}
    
    -- Try to find string concatenation patterns
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local success, module = pcall(require, obj)
            if success and type(module) == "table" then
                -- Look for string parts
                for k, v in pairs(module) do
                    if type(v) == "string" and #v < 100 then
                        -- Check if it looks like part of a URL
                        if string.match(v, "^https?://") or 
                           string.match(v, "%.com") or
                           string.match(v, "firebase") then
                            table.insert(reconstructed, {
                                module = obj.Name,
                                key = k,
                                part = v
                            })
                        end
                    end
                end
            end
        end
    end
    
    return {
        test = "String Reconstruction",
        found = #reconstructed > 0,
        parts = reconstructed
    }
end

-- Run advanced tests
function AdvancedTests.RunAll()
    print("\n🔥 RUNNING ADVANCED PENETRATION TESTS\n")
    
    local results = {
        AdvancedTests.TestHttpGetHook(),
        AdvancedTests.TestRequestAsyncHook(),
        AdvancedTests.TestStringReconstruction()
    }
    
    for _, result in ipairs(results) do
        local status = result.vulnerable and "❌ VULNERABLE" or "✅ SECURE"
        print(status .. ": " .. result.test)
        
        if result.captured and #result.captured > 0 then
            print("   Captured URLs:", #result.captured)
        end
        if result.requests and #result.requests > 0 then
            print("   Intercepted requests:", #result.requests)
        end
        if result.parts and #result.parts > 0 then
            print("   String parts found:", #result.parts)
        end
    end
end

return AdvancedTests
