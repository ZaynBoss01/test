--!strict
-- Firebase URL Leak Test Script
-- Apne hi game pe test karne ke liye

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer
local results = {}

local function log(category, found)
    table.insert(results, {cat = category, val = found})
    print(("[LEAK] %s -> %s"):format(category, tostring(found)))
end

-- PATTERNS jo Firebase URL match karte hain
local FIREBASE_PATTERNS = {
    "firebaseio%.com",
    "firebasedatabase%.app",
    "firebaseapp%.com",
    "%.firebase%.",
    "https://[%w%-]+%-default%-rtdb",
}

local function matchesFirebase(str)
    if type(str) ~= "string" then return false end
    if #str < 10 or #str > 500 then return false end
    for _, pat in ipairs(FIREBASE_PATTERNS) do
        if str:match(pat) then return true end
    end
    return false
end

-- ============================================================
-- 1. INSTANCE SCAN (getdescendants)
-- ============================================================
local function scanInstances()
    print("[*] Scanning instances...")
    local roots = {
        game:GetService("Workspace"),
        game:GetService("ReplicatedStorage"),
        game:GetService("ServerScriptService"),
        game:GetService("ServerStorage"),
        game:GetService("StarterGui"),
        game:GetService("StarterPlayer"),
        game:GetService("Lighting"),
        game:GetService("SoundService"),
        game:GetService("Chat"),
        game:GetService("LocalizationService"),
    }
    
    for _, root in ipairs(roots) do
        local ok, desc = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, obj in ipairs(desc) do
                -- StringValue / StringAttribute
                if obj:IsA("StringValue") and matchesFirebase(obj.Value) then
                    log("Instance.StringValue", obj:GetFullName() .. " = " .. obj.Value)
                end
                
                -- Attributes
                local ok2, attrs = pcall(function() return obj:GetAttributes() end)
                if ok2 then
                    for name, val in pairs(attrs) do
                        if matchesFirebase(val) then
                            log("Instance.Attribute", obj:GetFullName() .. "." .. name .. " = " .. val)
                        end
                    end
                end
                
                -- Object name / other props
                if matchesFirebase(obj.Name) then
                    log("Instance.Name", obj:GetFullName())
                end
            end
        end
    end
end

-- ============================================================
-- 2. GLOBALS SCAN (_G, shared)
-- ============================================================
local function scanGlobals()
    print("[*] Scanning globals...")
    
    -- _G scan
    for k, v in pairs(_G) do
        if matchesFirebase(v) then
            log("_G", k .. " = " .. v)
        elseif type(v) == "table" then
            for k2, v2 in pairs(v) do
                if matchesFirebase(v2) then
                    log("_G.table", k .. "." .. tostring(k2) .. " = " .. v2)
                end
            end
        end
    end
    
    -- shared scan
    for k, v in pairs(shared) do
        if matchesFirebase(v) then
