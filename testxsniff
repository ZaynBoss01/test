end

-- ============================================================
-- 3. HTTP SERVICE LOGGING (hook requests)
-- ============================================================
local function hookHttp()
    print("[*] Hooking HttpService...")
    
    local oldRequest = HttpService.RequestAsync
    local oldGet = HttpService.GetAsync
    
    -- Note: Client pe ye kaam nahi karega agar server-side hai
    -- Par agar client se koi request jaa rahi hai to pakad lega
    
    local mt = getrawmetatable and getrawmetatable(game)
    if mt and setreadonly then
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if key == "RequestAsync" or key == "GetAsync" or key == "PostAsync" then
                return newcclosure(function(_, ...)
                    local args = {...}
                    for _, a in ipairs(args) do
                        if matchesFirebase(a) then
                            log("HttpService." .. key, tostring(a))
                        end
                    end
                    return oldIndex(self, key)(_, ...)
                end)
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end
end

-- ============================================================
-- 4. UPVALUE SCANNING (closures)
-- ============================================================
local function scanUpvalues()
    print("[*] Scanning upvalues...")
    
    if not getgc then 
        print("[!] getgc not available, skipping")
        return 
    end
    
    local gc = getgc(true)
    for _, obj in ipairs(gc) do
        if type(obj) == "function" then
            local ok, info = pcall(debug.getinfo, obj, "u")
            if ok and info and info.nups then
                for i = 1, info.nups do
                    local name, val = debug.getupvalue(obj, i)
                    if matchesFirebase(val) then
                        log("Upvalue", (name or "?") .. " = " .. val)
                    elseif type(val) == "table" then
                        -- nested table scan (limited)
                        local count = 0
                        for k2, v2 in pairs(val) do
                            count = count + 1
                            if count > 50 then break end
                            if matchesFirebase(v2) then
                                log("Upvalue.table", tostring(name) .. "." .. tostring(k2) .. " = " .. v2)
                            end
                        end
                    end
                end
            end
        end
    end
end

