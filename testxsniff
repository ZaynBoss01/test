-- ============================================
-- FIREBASE SECURITY TEST SCRIPT
-- Purpose: Test all protection layers
-- ============================================

local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

-- Test Results Storage
local TestResults = {}
local VulnerabilitiesFound = 0

-- ============================================
-- TEST 1: STRING PATTERN MATCHING
-- ============================================
local function TestStringExtraction()
    print("\n🔍 TEST 1: String Pattern Matching")
    
    -- Get all modulescripts and scripts
    local allScripts = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ModuleScript") or obj:IsA("Script") or obj:IsA("LocalScript") then
            table.insert(allScripts, obj)
        end
    end
    
    -- Common Firebase URL patterns
    local patterns = {
        "firebaseio%.com",
        "firebase%-database",
        "firebasedatabase%.app",
        "%.firebase",
        "database%.google",
        "realtime%-database",
        "https?://[%w%-%.]+%.firebaseio",
        "projects/[%w%-]+/databases",
    }
    
    local foundUrls = {}
    
    for _, scriptObj in ipairs(allScripts) do
        local success, source = pcall(function()
            return scriptObj.Source
        end)
        
        if success and source then
            for _, pattern in ipairs(patterns) do
                local matches = {string.gmatch(source, pattern)}
                for match in pairs(matches) do
                    table.insert(foundUrls, {
                        script = scriptObj.Name,
                        pattern = pattern,
                        match = match
                    })
                end
            end
        end
    end
    
    if #foundUrls > 0 then
        print("❌ VULNERABILITY: URLs found in plain text!")
        VulnerabilitiesFound = VulnerabilitiesFound + 1
        for _, url in ipairs(foundUrls) do
            print("   Found in:", url.script, "| Pattern:", url.pattern)
        end
    else
        print("✅ PASS: No plain text URLs found")
    end
    
    TestResults.StringTest = #foundUrls == 0
end

-- ============================================
-- TEST 2: MEMORY DUMP SIMULATION
-- ============================================
local function TestMemoryExtraction()
    print("\n🔍 TEST 2: Memory Analysis")
    
    -- Check _G and shared tables
    local globalVars = {}
    for k, v in pairs(_G) do
        if type(v) == "string" and (string.find(v, "http") or string.find(v, "firebase")) then
            table.insert(globalVars, {key = k, value = v})
        end
    end
    
    -- Check shared
    if shared then
        for k, v in pairs(shared) do
            if type(v) == "string" and (string.find(v, "http") or string.find(v, "firebase")) then
                table.insert(globalVars, {key = "shared."..k, value = v})
            end
        end
    end
    
    -- Check getfenv
    local env = getfenv()
    for k, v in pairs(env) do
        if type(v) == "string" and (string.find(v, "http") or string.find(v, "firebase")) then
            table.insert(globalVars, {key = "env."..k, value = v})
        end
    end
    
    if #globalVars > 0 then
        print("❌ VULNERABILITY: URLs found in global/shared tables!")
        VulnerabilitiesFound = VulnerabilitiesFound + 1
        for _, var in ipairs(globalVars) do
            print("   Variable:", var.key, "| Value:", string.sub(var.value, 1, 50).."...")
        end
    else
        print("✅ PASS: No URLs in global memory")
    end
    
    TestResults.MemoryTest = #globalVars == 0
end

-- ============================================
-- TEST 3: HTTP REQUEST INTERCEPTION
-- ============================================
local function TestHttpInterception()
    print("\n🔍 TEST 3: HTTP Request Interception")
    
    -- Hook into HttpService
    local originalRequest = HttpService.RequestAsync
    local capturedRequests = {}
    
    -- Attempt to hook (this might fail due to security)
    local success = pcall(function()
        HttpService.RequestAsync = function(self, ...)
            local args = {...}
            table.insert(capturedRequests, args)
            return originalRequest(self, ...)
        end
    end)
    
    if success then
        print("⚠️ WARNING: HttpService hook successful - this is a vulnerability!")
        VulnerabilitiesFound = VulnerabilitiesFound + 1
    else
        print("✅ PASS: HttpService is protected from hooking")
    end
    
    TestResults.HttpTest = not success
end

-- ============================================
-- TEST 4: REQUIRE MODULE ANALYSIS
-- ============================================
local function TestModuleAnalysis()
    print("\n🔍 TEST 4: Module Analysis")
    
    local suspiciousModules = {}
    
    -- Check all ModuleScripts
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local success, result = pcall(function()
                return require(obj)
            end)
            
            if success and type(result) == "table" then
                -- Check if module returns URL patterns
                for k, v in pairs(result) do
                    if type(v) == "string" then
                        if string.find(v, "firebase") or string.find(v, "database") or string.find(v, "http") then
                            table.insert(suspiciousModules, {
                                name = obj.Name,
                                key = k,
                                value = string.sub(v, 1, 50)
                            })
                        end
                    end
                end
            end
        end
    end
    
    if #suspiciousModules > 0 then
        print("❌ VULNERABILITY: URLs exposed in module returns!")
        VulnerabilitiesFound = VulnerabilitiesFound + 1
        for _, mod in ipairs(suspiciousModules) do
            print("   Module:", mod.name, "| Key:", mod.key)
        end
    else
        print("✅ PASS: No URLs exposed in modules")
    end
    
    TestResults.ModuleTest = #suspiciousModules == 0
end

-- ============================================
-- TEST 5: REMOTE EVENT ANALYSIS
-- ============================================
local function TestRemoteEventAnalysis()
    print("\n🔍 TEST 5: Remote Event Analysis")
    
    local suspiciousRemotes = {}
    
    -- Check all RemoteEvents and RemoteFunctions
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            -- Check for suspicious names
            local name = string.lower(obj.Name)
            if string.find(name, "firebase") or 
               string.find(name, "database") or 
               string.find(name, "url") or
               string.find(name, "config") then
                table.insert(suspiciousRemotes, obj)
            end
        end
    end
    
    if #suspiciousRemotes > 0 then
        print("⚠️ WARNING: Potentially exposed RemoteEvents found:")
        for _, remote in ipairs(suspiciousRemotes) do
            print("   -", remote.Name, "("..remote.ClassName..")")
        end
        print("   Make sure these don't expose sensitive data!")
    else
        print("✅ PASS: No suspicious RemoteEvents found")
    end
    
    TestResults.RemoteTest = #suspiciousRemotes == 0
end

-- ============================================
-- TEST 6: OBFUSCATION CHECK
-- ============================================
local function TestObfuscationStrength()
    print("\n🔍 TEST 6: Obfuscation Strength")
    
    local readableScripts = 0
    local totalScripts = 0
    
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            totalScripts = totalScripts + 1
            local success, source = pcall(function()
                return obj.Source
            end)
            
            if success and source then
                -- Check if source is readable/obfuscated
                local readableChars = 0
                for i = 1, math.min(#source, 100) do
                    local byte = string.byte(source, i)
                    if byte >= 32 and byte <= 126 then
                        readableChars = readableChars + 1
                    end
                end
                
                local readability = readableChars / math.min(#source, 100)
                if readability > 0.8 then
                    readableScripts = readableScripts + 1
                end
            end
        end
    end
    
    if readableScripts > 0 then
        print("⚠️ INFO:", readableScripts, "/", totalScripts, "scripts are readable")
        print("   Consider obfuscating your Firebase connection script")
    else
        print("✅ PASS: Scripts appear obfuscated")
    end
end

-- ============================================
-- TEST 7: RUNTIME URL EXTRACTION ATTEMPT
-- ============================================
local function TestRuntimeExtraction()
    print("\n🔍 TEST 7: Runtime Extraction Attempts")
    
    -- Try to find URL in common variable names
    local commonNames = {
        "url", "URL", "firebaseUrl", "databaseUrl", "dbUrl",
        "endpoint", "baseUrl", "apiUrl", "firebaseURL",
        "DatabaseURL", "FirebaseURL", "config", "CONFIG"
    }
    
    local foundInRuntime = {}
    
    -- Check _G
    for _, name in ipairs(commonNames) do
        if _G[name] then
            table.insert(foundInRuntime, {location = "_G", name = name, value = tostring(_G[name])})
        end
    end
    
    -- Check shared
    if shared then
        for _, name in ipairs(commonNames) do
            if shared[name] then
                table.insert(foundInRuntime, {location = "shared", name = name, value = tostring(shared[name])})
            end
        end
    end
    
    if #foundInRuntime > 0 then
        print("❌ VULNERABILITY: URL variables found at runtime!")
        VulnerabilitiesFound = VulnerabilitiesFound + 1
        for _, var in ipairs(foundInRuntime) do
            print("   Location:", var.location, "| Name:", var.name)
        end
    else
        print("✅ PASS: No URL variables in runtime environment")
    end
    
    TestResults.RuntimeTest = #foundInRuntime == 0
end

