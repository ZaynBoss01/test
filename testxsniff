-- ============================================================
-- 6. REMOTE EVENT SNIFFING
-- ============================================================
local function hookRemotes()
    print("[*] Hooking remotes...")
    
    -- Incoming RemoteEvent
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local ok = pcall(function()
                obj.OnClientEvent:Connect(function(...)
                    for _, a in ipairs({...}) do
                        if matchesFirebase(a) then
                            log("RemoteEvent.In", obj:GetFullName() .. " = " .. tostring(a))
                        end
                    end
                end)
            end)
        end
    end
    
    -- Outgoing via metatable
    local mt = getrawmetatable and getrawmetatable(game)
    if mt and setreadonly then
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                for _, a in ipairs({...}) do
                    if matchesFirebase(a) then
                        log("Remote." .. method, tostring(self) .. " = " .. tostring(a))
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end
end

-- ============================================================
-- 7. PLAYER / CHARACTER SCAN
-- ============================================================
local function scanPlayer()
    print("[*] Scanning player objects...")
    
    if LP then
        for _, obj in ipairs(LP:GetDescendants()) do
            if obj:IsA("StringValue") and matchesFirebase(obj.Value) then
                log("Player.StringValue", obj:GetFullName() .. " = " .. obj.Value)
            end
        end
        
        -- Leaderstats
        local ls = LP:FindFirstChild("leaderstats")
        if ls then
            for _, v in ipairs(ls:GetChildren()) do
                if matchesFirebase(v.Value) then
                    log("leaderstats", v.Name .. " = " .. tostring(v.Value))
                end
            end
        end
    end
end

-- ============================================================
-- RUN ALL TESTS
-- ============================================================
local function runAll()
    print("=" .. string.rep("=", 50))
    print("FIREBASE URL LEAK TEST - START")
    print("=" .. string.rep("=", 50))
    
    local tests = {
        {"Instances", scanInstances},
        {"Globals", scanGlobals},
        {"HttpService", hookHttp},
        {"Upvalues", scanUpvalues},
        {"Remotes", hookRemotes},
        {"Player", scanPlayer},
    }
    
    for _, t in ipairs(tests) do
        local ok, err = pcall(t[2])
        if not ok then
            print(("[!] %s failed: %s"):format(t[1], tostring(err)))
        end
    end
    
    task.wait(3) -- remotes ke liye wait
    
    print("=" .. string.rep("=", 50))
    print(("TOTAL LEAKS FOUND: %d"):format(#results))
    print("=" .. string.rep("=", 50))
    
    if #results == 0 then
        print("✅ PROTECTION WORKING - Koi leak nahi mila")
    else
        print("❌ PROTECTION FAILED - Ye leaks mile:")
        for i, r in ipairs(results) do
            print(("[%d] %s -> %s"):format(i, r.cat, r.val))
        end
    end
    
    -- Copyable output
    if #results > 0 and setclipboard then
        local out = ""
        for _, r in ipairs(results) do
            out = out .. r.cat .. " -> " .. r.val .. "\n"
        end
        setclipboard(out)
        print("[*] Results clipboard mein copy kar diye")
    end
end

runAll()
