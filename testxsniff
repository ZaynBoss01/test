-- ============================================================
-- ARES SCRIPT - FIREBASE URL HUNTER
-- Sirf "Ares" related cheezein scan karega
-- ============================================================

print("========================================")
print("[ARES HUNTER] Starting...")
print("========================================")

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local SS = game:GetService("ServerStorage")
local SSS = game:GetService("ServerScriptService")
local LP = Players.LocalPlayer

local ARES_KEYWORDS = {
    "ares", "Ares", "ARES",
    "firebase", "Firebase",
    "database", "databaseURL",
    "rtdb", "firebaseio",
    "apiKey", "authDomain",
}

local FIREBASE_PATTERNS = {
    "firebaseio%.com",
    "firebasedatabase%.app",
    "firebaseapp%.com",
    "https://[%w%-]+%-default%-rtdb",
    "https://[%w%-]+%.firebase",
}

local leaks = {}

local function isFirebase(str)
    if type(str) ~= "string" then return false end
    for _, p in ipairs(FIREBASE_PATTERNS) do
        if str:match(p) then return true end
    end
    return false
end

local function hasAres(str)
    if type(str) ~= "string" then return false end
    for _, k in ipairs(ARES_KEYWORDS) do
        if str:find(k, 1, true) then return true end
    end
    return false
end

local function record(source, key, value)
    table.insert(leaks, {src=source, k=key, v=value})
    print(("[LEAK] %s | %s = %s"):format(source, tostring(key), tostring(value)))
end

-- ============================================================
-- STEP 1: Ares naam ke objects dhundho
-- ============================================================
print("\n[STEP 1] Ares objects dhundh rahe hain...")

local aresObjects = {}

for _, root in ipairs({RS, SS, SSS, game:GetService("Workspace"), game:GetService("StarterGui"), game:GetService("StarterPlayer")}) do
    local ok, desc = pcall(function() return root:GetDescendants() end)
    if ok then
        for _, obj in ipairs(desc) do
            -- Object ka naam Ares related hai?
            if hasAres(obj.Name) then
                table.insert(aresObjects, obj)
                print(("[FOUND] %s (%s)"):format(obj:GetFullName(), obj.ClassName))
            end
            
            -- StringValue ka value Ares related hai?
            if obj:IsA("StringValue") and hasAres(obj.Value) then
                table.insert(aresObjects, obj)
                print(("[FOUND-VAL] %s = %s"):format(obj:GetFullName(), obj.Value))
            end
        end
    end
end

print(("[STEP 1] Total Ares-related objects: %d"):format(#aresObjects))

-- ============================================================
-- STEP 2: Ares objects ke andar Firebase URL dhundho
-- ============================================================
print("\n[STEP 2] Ares objects mein Firebase URL dhundh rahe hain...")

for _, obj in ipairs(aresObjects) do
    -- StringValue check
    if obj:IsA("StringValue") then
        if isFirebase(obj.Value) then
            record("AresObj.StringValue", obj:GetFullName(), obj.Value)
        end
    end
    
    -- Attributes check
    local ok, attrs = pcall(function() return obj:GetAttributes() end)
    if ok then
        for k, v in pairs(attrs) do
            if isFirebase(v) then
                record("AresObj.Attribute", obj:GetFullName().."."..k, v)
            end
        end
    end
    
    -- Children StringValues
    for _, child in ipairs(obj:GetChildren()) do
        if child:IsA("StringValue") and isFirebase(child.Value) then
            record("AresChild.StringValue", child:GetFullName(), child.Value)
        end
    end
end

-- ============================================================
-- STEP 3: Ares REMOTE EVENTS dhundho
-- ============================================================
print("\n[STEP 3] Ares remotes dhundh rahe hain...")

for _, root in ipairs({RS, SS, game:GetService("Workspace")}) do
    local ok, desc = pcall(function() return root:GetDescendants() end)
    if ok then
        for _, obj in ipairs(desc) do
            if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent")) 
               and hasAres(obj.Name) then
                print(("[REMOTE] %s (%s)"):format(obj:GetFullName(), obj.ClassName))
                
                -- Remote ke andar bhi check karo
                for _, c in ipairs(obj:GetChildren()) do
                    if c:IsA("StringValue") and isFirebase(c.Value) then
                        record("AresRemote", c:GetFullName(), c.Value)
                    end
                end
            end
        end
    end
end

-- ============================================================
-- STEP 4: Ares ModuleScripts dhundho aur unhe require karo
-- ============================================================
print("\n[STEP 4] Ares modules scan kar rahe hain...")

for _, obj in ipairs(aresObjects) do
    if obj:IsA("ModuleScript") then
        print(("[MODULE] Trying to require: %s"):format(obj:GetFullName()))
        local ok, result = pcall(require, obj)
        if ok and type(result) == "table" then
            -- Table ke andar URL dhundho
            for k, v in pairs(result) do
                if isFirebase(v) then
                    record("AresModule", obj.Name.."."..tostring(k), v)
                elseif type(v) == "table" then
                    for k2, v2 in pairs(v) do
                        if isFirebase(v2) then
                            record("AresModule.nested", obj.Name.."."..tostring(k).."."..tostring(k2), v2)
                        end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- STEP 5: _G aur shared mein Ares dhundho
-- ============================================================
print("\n[STEP 5] Globals mein Ares dhundh rahe hain...")

for k, v in pairs(_G) do
    if hasAres(tostring(k)) or hasAres(tostring(v)) then
        print(("[GLOBAL] _G.%s = %s"):format(tostring(k), tostring(v)))
        if isFirebase(v) then
            record("_G", k, v)
        end
    end
    if type(v) == "table" then
        for k2, v2 in pairs(v) do
            if isFirebase(v2) then
                record("_G.nested", tostring(k).."."..tostring(k2), v2)
            end
        end
    end
end

for k, v in pairs(shared) do
    if hasAres(tostring(k)) or isFirebase(v) then
        print(("[SHARED] shared.%s = %s"):format(tostring(k), tostring(v)))
        if isFirebase(v) then
            record("shared", k, v)
        end
    end
end

-- ============================================================
-- STEP 6: HttpService hook (Ares URL pakadne ke liye)
-- ============================================================
print("\n[STEP 6] HttpService requests hook kar rahe hain...")

local HttpService = game:GetService("HttpService")

if getrawmetatable and setreadonly and newcclosure then
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "RequestAsync" or method == "GetAsync" or method == "PostAsync" then
            local args = {...}
            for _, a in ipairs(args) do
                if type(a) == "string" and (isFirebase(a) or hasAres(a)) then
                    record("HttpService."..method, "URL", a)
                end
                if type(a) == "table" then
                    for k, v in pairs(a) do
                        if isFirebase(v) or (type(v)=="string" and hasAres(v)) then
                            record("HttpService."..method.."."..k, "value", v)
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
    print("[STEP 6] Hook installed - HTTP requests monitor ho rahi hain")
else
    print("[STEP 6] SKIP - no metatable access")
end

-- ============================================================
-- STEP 7: Ares objects ke upvalues scan karo
-- ============================================================
print("\n[STEP 7] Ares functions ke upvalues scan kar rahe hain...")

if getgc and debug and debug.getupvalue then
    local gc = getgc(true)
    for _, obj in ipairs(gc) do
        if type(obj) == "function" then
            local ok, info = pcall(debug.getinfo, obj, "u")
            if ok and info and info.nups then
                for i = 1, info.nups do
                    local name, val = debug.getupvalue(obj, i)
                    if isFirebase(val) then
                        record("Upvalue", tostring(name), val)
                    end
                    if type(val) == "table" then
                        for k2, v2 in pairs(val) do
                            if isFirebase(v2) then
                                record("Upvalue.table", tostring(name).."."..tostring(k2), v2)
                            end
                        end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- STEP 8: Player ke andar Ares-related kuch?
-- ============================================================
print("\n[STEP 8] Player objects scan...")

if LP then
    for _, obj in ipairs(LP:GetDescendants()) do
        if obj:IsA("StringValue") and (isFirebase(obj.Value) or hasAres(obj.Value)) then
            record("Player.StringValue", obj:GetFullName(), obj.Value)
        end
        if hasAres(obj.Name) then
            print(("[PLAYER-FOUND] %s (%s)"):format(obj:GetFullName(), obj.ClassName))
        end
    end
end

